---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const basePrefix = base ? base + "/" : "/";
const defaultLocale = "zh";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 - Page not found - Pify Agent Book</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/docs/favicon.svg" />
    <style>
      :root {
        --ink:   #1c1917;
        --ink-2: #44403c;
        --mute:  #78716c;
        --line:  #e7e5e4;
        --paper: #fafaf9;
        --accent: #c2410c;
        --accent-glow: rgba(194, 65, 12, 0.18);
        --serif: "Geist", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        --mono:  ui-monospace, "SF Mono", "Cascadia Code", Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink:   #fafaf9;
          --ink-2: #d6d3d1;
          --mute:  #a8a29e;
          --line:  #292524;
          --paper: #0c0a09;
          --accent-glow: rgba(251, 146, 60, 0.22);
        }
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        font-family: var(--serif);
        background: var(--paper);
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        display: flex; align-items: center; justify-content: center;
        padding: 2rem;
      }
      .frame {
        position: relative;
        width: 100%;
        max-width: 640px;
        padding: 3rem 2.5rem;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: color-mix(in srgb, var(--paper) 70%, transparent);
        box-shadow:
          0 1px 2px rgba(0,0,0,0.04),
          0 24px 60px -28px rgba(0,0,0,0.12);
        overflow: hidden;
      }
      .frame::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 0% 0%, var(--accent-glow) 0%, transparent 50%);
        pointer-events: none;
      }
      .code {
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--mute);
        letter-spacing: 0.05em;
        margin: 0 0 0.75rem;
      }
      .code-dot {
        display: inline-block;
        width: 7px; height: 7px;
        background: var(--accent);
        border-radius: 50%;
        margin-right: 0.5rem;
        vertical-align: middle;
        animation: dot 2.4s ease-in-out infinite;
      }
      @keyframes dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: 0.55; transform: scale(0.85); }
      }
      h1 {
        font-size: clamp(3rem, 9vw, 5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.05em;
        margin: 0;
        color: var(--ink);
      }
      h1 .accent { color: var(--accent); }
      p.lead {
        margin: 1rem 0 0;
        color: var(--ink-2);
        font-size: 1.05rem;
        line-height: 1.5;
        max-width: 30rem;
      }
      p.path {
        margin: 1.5rem 0 0;
        font-family: var(--mono);
        font-size: 0.85rem;
        color: var(--mute);
        background: color-mix(in srgb, var(--line) 35%, transparent);
        padding: 0.55rem 0.75rem;
        border-radius: 6px;
        border: 1px solid var(--line);
        word-break: break-all;
      }
      .actions {
        margin: 2rem 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
      }
      .btn {
        display: inline-flex; align-items: center; gap: 0.4rem;
        padding: 0.7rem 1.2rem;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 999px;
        text-decoration: none;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      }
      .btn:hover { transform: translateY(-2px); }
      .btn-primary {
        background: var(--ink);
        color: var(--paper);
        border: 1px solid var(--ink);
      }
      .btn-secondary {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--line);
      }
      .btn-secondary:hover {
        border-color: var(--accent);
      }
      .links {
        margin: 2rem 0 0;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        display: flex; flex-wrap: wrap; gap: 1rem 1.5rem;
      }
      .links a {
        color: var(--ink-2);
        text-decoration: none;
        font-size: 0.92rem;
      }
      .links a:hover { color: var(--accent); }
      .links-label {
        width: 100%;
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--mute);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin: 0 0 0.5rem;
      }
    </style>
  </head>
  <body>
    <div class="frame">
      <p class="code"><span class="code-dot"></span>ERROR_404 // RESOURCE_NOT_FOUND</p>
      <h1>Page <span class="accent">not found</span></h1>
      <p class="lead">The page you tried to reach does not exist or has been moved. If you arrived here from a link, the source may have been renamed.</p>
      <p class="path" id="path">/unknown</p>

      <div class="actions">
        <a class="btn btn-primary" href={basePrefix + defaultLocale}>Open the book &rarr;</a>
        <a class="btn btn-secondary" href={basePrefix + "en/ch01-overview"}>Chapter 1</a>
        <a class="btn btn-secondary" href="https://github.com/pifydev/docs/issues">Report a broken link</a>
      </div>

      <div class="links">
        <p class="links-label">Quick jump</p>
        <a href={basePrefix + "en/ch02-three-layer-arch"}>Architecture</a>
        <a href={basePrefix + "en/ch03-agent-loop"}>Agent loop</a>
        <a href={basePrefix + "en/ch05-tool-system"}>Tools</a>
        <a href={basePrefix + "en/ch07-event-driven"}>Events</a>
        <a href={basePrefix + "en/ch10-session"}>Session</a>
      </div>
    </div>

    <script>
      // Show the path the user tried to visit
      var p = document.getElementById('path');
      if (p) p.textContent = window.location.pathname || '/unknown';
    </script>
  </body>
</html>
