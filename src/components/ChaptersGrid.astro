---
type Language = "zh" | "en" | "vi";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const basePrefix = base ? base + "/" : "/";

// Chapter accent colors are desaturated category hues, not a rainbow.
// One warm-leaning palette per chapter, all at the same muted saturation
// so the page reads as "editorial sections" instead of "AI gradient slop".
const chapters = [
  {
    num: 1,
    slug: "ch01-overview",
    icon: "book",
    accent: 1,
    title_en: "Introduction: Why Pi-Agent Is Worth Your Time",
    title_vi: "M\u1edf \u0111\u1ea7u: T\u1ea1i sao Pi-Agent \u0111\u00e1ng \u0111\u1ec3 b\u1ea1n d\u00e0nh th\u1eddi gian",
    title_zh: "\u5f00\u7bc7: \u4e3a\u4ec0\u4e48 Pi-Agent \u503c\u5f97\u4f60\u82b1\u65f6\u95f4",
    desc_en: "The three identities of Pi: coding tool, learning material, development SDK.",
    desc_vi: "Ba danh t\u00ednh c\u1ee7a Pi: c\u00f4ng c\u1ee5 code, t\u00e0i li\u1ec7u h\u1ecdc, SDK ph\u00e1t tri\u1ec3n.",
    desc_zh: "Pi \u7684\u4e09\u91cd\u8eab\u4efd: \u7f16\u7801\u5de5\u5177\u3001\u5b66\u4e60\u8d44\u6599\u3001\u5f00\u53d1 SDK\u3002",
    tag_en: "Overview",
    tag_vi: "T\u1ed5ng quan",
    tag_zh: "\u603b\u89c8",
  },
  {
    num: 2,
    slug: "ch02-three-layer-arch",
    icon: "layers",
    accent: 2,
    title_en: "Three-Layer Architecture",
    title_vi: "Ki\u1ebfn tr\u00fac ba l\u1edbp",
    title_zh: "\u4e09\u5c42\u67b6\u6784",
    desc_en: "Where the code lives, how packages depend on each other, and how types flow.",
    desc_vi: "M\u00e3 n\u1eb7m \u1edf \u0111\u00e2u, c\u00e1c package ph\u1ee5 thu\u1ed9c l\u1eabn nhau, v\u00e0 ki\u1ec3u d\u1eef li\u1ec7u ch\u1ea3y qua c\u00e1c l\u1edbp.",
    desc_zh: "\u4ee3\u7801\u5728\u54ea\u91cc\u3001\u5404 package \u5982\u4f55\u4e92\u76f8\u4f9d\u8d56\u3001\u7c7b\u578b\u5982\u4f55\u4ece\u4e00\u5c42\u6d41\u5411\u53e6\u4e00\u5c42\u3002",
    tag_en: "Architecture",
    tag_vi: "Ki\u1ebfn tr\u00fac",
    tag_zh: "\u67b6\u6784",
  },
  {
    num: 3,
    slug: "ch03-agent-loop",
    icon: "loop",
    accent: 3,
    title_en: "Agent Loop",
    title_vi: "Agent Loop",
    title_zh: "Agent Loop",
    desc_en: "The engine that calls the model, parses tool calls, and loops until done.",
    desc_vi: "Engine g\u1ecdi m\u00f4 h\u00ecnh, parse tool call, v\u00e0 l\u1eb7p l\u1ea1i cho \u0111\u1ebfn khi xong.",
    desc_zh: "\u5f15\u64ce\u8c03\u7528\u6a21\u578b\u3001\u89e3\u6790\u5de5\u5177\u8c03\u7528\u3001\u5faa\u73af\u76f4\u5230\u5b8c\u6210\u3002",
    tag_en: "Core",
    tag_vi: "L\u00f5i",
    tag_zh: "\u6838\u5fc3",
  },
  {
    num: 4,
    slug: "ch04-model-invocation",
    icon: "plug",
    accent: 4,
    title_en: "Model Invocation",
    title_vi: "G\u1ecdi m\u00f4 h\u00ecnh",
    title_zh: "\u6a21\u578b\u8c03\u7528",
    desc_en: "One line, 30+ providers. Translators, SSE parsing, thinking-mode dials.",
    desc_vi: "M\u1ed9t d\u00f2ng, h\u01a1n 30 provider. Translator, SSE parser, thinking-mode.",
    desc_zh: "\u4e00\u884c\u4ee3\u7801\uff0c30+ provider\u3002Translator\u3001SSE \u89e3\u6790\u3001thinking-mode \u8c03\u8282\u3002",
    tag_en: "Integration",
    tag_vi: "T\u00edch h\u1ee3p",
    tag_zh: "\u96c6\u6210",
  },
  {
    num: 5,
    slug: "ch05-tool-system",
    icon: "wrench",
    accent: 5,
    title_en: "Tool System",
    title_vi: "H\u1ec7 th\u1ed1ng c\u00f4ng c\u1ee5",
    title_zh: "\u5de5\u5177\u7cfb\u7edf",
    desc_en: "How tools are declared, validated, executed, and reported back to the model.",
    desc_vi: "C\u00f4ng c\u1ee5 \u0111\u01b0\u1ee3c khai b\u00e1o, validate, th\u1ef1c thi v\u00e0 tr\u1ea3 k\u1ebft qu\u1ea3 cho m\u00f4 h\u00ecnh.",
    desc_zh: "\u5de5\u5177\u5982\u4f55\u88ab\u58f0\u660e\u3001\u6821\u9a8c\u3001\u6267\u884c\u5e76\u56de\u4f20\u7ed9\u6a21\u578b\u3002",
    tag_en: "Runtime",
    tag_vi: "Runtime",
    tag_zh: "\u8fd0\u884c\u65f6",
  },
  {
    num: 6,
    slug: "ch06-messages",
    icon: "chat",
    accent: 6,
    title_en: "Message System",
    title_vi: "H\u1ec7 th\u1ed1ng tin nh\u1eafn",
    title_zh: "\u6d88\u606f\u7cfb\u7edf",
    desc_en: "The shape of memory: roles, content blocks, and how agents pass them around.",
    desc_vi: "H\u00ecnh d\u1ea1ng b\u1ed9 nh\u1edb: role, content block, v\u00e0 c\u00e1ch agent truy\u1ec1n gi\u1eefa nhau.",
    desc_zh: "\u8bb0\u5fc6\u7684\u5f62\u72b6\uff1arole\u3001content block \u4ee5\u53ca agent \u4e4b\u95f4\u5982\u4f55\u4f20\u9012\u3002",
    tag_en: "Data model",
    tag_vi: "M\u00f4 h\u00ecnh d\u1eef li\u1ec7u",
    tag_zh: "\u6570\u636e\u6a21\u578b",
  },
  {
    num: 7,
    slug: "ch07-event-driven",
    icon: "antenna",
    accent: 7,
    title_en: "Event-Driven Architecture",
    title_vi: "Ki\u1ebfn tr\u00fac h\u01b0\u1edbng s\u1ef1 ki\u1ec7n",
    title_zh: "\u4e8b\u4ef6\u9a71\u52a8\u67b6\u6784",
    desc_en: "How the agent loop emits typed events and how the TUI subscribes to them.",
    desc_vi: "C\u00e1ch agent loop ph\u00e1t s\u1ef1 ki\u1ec7n c\u00f3 ki\u1ec3u v\u00e0 c\u00e1ch TUI subscribe.",
    desc_zh: "Agent loop \u5982\u4f55\u53d1\u51fa\u5e26\u7c7b\u578b\u7684\u4e8b\u4ef6\u3001TUI \u5982\u4f55\u8ba2\u9605\u3002",
    tag_en: "Reactivity",
    tag_vi: "Ph\u1ea3n \u1ee9ng",
    tag_zh: "\u54cd\u5e94\u5f0f",
  },
  {
    num: 8,
    slug: "ch08-context-engineering",
    icon: "compass",
    accent: 8,
    title_en: "Context Engineering",
    title_vi: "K\u1ef9 thu\u1eadt ng\u1eef c\u1ea3nh",
    title_zh: "\u4e0a\u4e0b\u6587\u5de5\u7a0b",
    desc_en: "Fitting infinite dialog into a finite window: prompts, system, skills.",
    desc_vi: "Nh\u00e9t h\u1ed9i tho\u1ea1i v\u00f4 h\u1ea1n v\u00e0o c\u1eedu s\u1ed5 h\u1eefu h\u1ea1n: prompt, system, skills.",
    desc_zh: "\u628a\u65e0\u9650\u5bf9\u8bdd\u5851\u8fdb\u6709\u9650\u7a97\u53e3\uff1aprompt\u3001system\u3001skills\u3002",
    tag_en: "Prompting",
    tag_vi: "Prompting",
    tag_zh: "Prompt",
  },
  {
    num: 9,
    slug: "ch09-compaction",
    icon: "compress",
    accent: 9,
    title_en: "Context Compaction",
    title_vi: "N\u00e9n ng\u1eef c\u1ea3nh",
    title_zh: "\u4e0a\u4e0b\u6587\u538b\u7f29",
    desc_en: "When the window fills up: branch summaries, leaf pruning, headroom recovery.",
    desc_vi: "Khi c\u1eedu s\u1ed5 \u0111\u1ea7y: t\u00f3m t\u1eaft nh\u00e1nh, t\u1ec9a l\u00e1, l\u1ea5y l\u1ea1i headroom.",
    desc_zh: "\u5f53\u7a97\u53e3\u88c5\u6ee1\uff1a\u5206\u652f\u6458\u8981\u3001\u53f6\u5b50\u4f8b\u987b\u3001\u91ca\u653e\u9884\u7559\u3002",
    tag_en: "Memory",
    tag_vi: "B\u1ed9 nh\u1edb",
    tag_zh: "\u8bb0\u5fc6",
  },
  {
    num: 10,
    slug: "ch10-session",
    icon: "save",
    accent: 10,
    title_en: "Session & Persistence",
    title_vi: "Phi\u00ean v\u00e0 l\u01b0u tr\u1eef",
    title_zh: "\u4f1a\u8bdd\u4e0e\u6301\u4e45\u5316",
    desc_en: "Sessions on disk: file format, branches, and how they survive restarts.",
    desc_vi: "Phi\u00ean tr\u00ean \u0111\u0129a: \u0111\u1ecbnh d\u1ea1ng file, nh\u00e1nh, v\u00e0 c\u00e1ch ch\u00fang s\u1ed1ng s\u00f3t qua restart.",
    desc_zh: "\u4f1a\u8bdd\u5728\u78c1\u76d8\u4e0a\uff1a\u6587\u4ef6\u683c\u5f0f\u3001\u5206\u652f\u3001\u4ee5\u53ca\u5982\u4f55\u5728\u91cd\u542f\u540e\u5b58\u6d3b\u3002",
    tag_en: "Persistence",
    tag_vi: "L\u01b0u tr\u1eef",
    tag_zh: "\u6301\u4e45\u5316",
  },
] as const;

const titleKey = lang === "vi" ? "title_vi" : lang === "zh" ? "title_zh" : "title_en";
const descKey  = lang === "vi" ? "desc_vi"  : lang === "zh" ? "desc_zh"  : "desc_en";
const tagKey   = lang === "vi" ? "tag_vi"   : lang === "zh" ? "tag_zh"   : "tag_en";

// Custom SVG icons per chapter (single stroke weight, no emoji)
const ICONS = {
  book:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg>',
  layers:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 5-9 5-9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></svg>',
  loop:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a4 4 0 0 1 0 8h-3l3 3M7 21a4 4 0 0 1 0-8h3l-3-3"/></svg>',
  plug:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4"/></svg>',
  wrench:  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5.66 5.66l-2.83 2.83a4 4 0 0 1-5.66-5.66z"/><path d="m2 22 8-8"/></svg>',
  chat:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  antenna: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12a10 10 0 0 1 20 0M5 12a7 7 0 0 1 14 0M8 12a4 4 0 0 1 8 0"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>',
  compass: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m16 8-2 6-6 2 2-6z"/></svg>',
  compress:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h6V3M20 9h-6V3M4 15h6v6M20 15h-6v6"/></svg>',
  save:    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3h11l5 5v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M7 3v6h10V3M7 21v-7h10v7"/></svg>',
};
---

<div id="chapters" class="chapters-grid">
  {chapters.map((ch) => (
    <a class={`chapter-card accent-${ch.accent}`} href={basePrefix + lang + "/" + ch.slug}>
      <div class="chapter-icon" aria-hidden="true" set:html={ICONS[ch.icon]} />
      <div class="chapter-body">
        <span class="chapter-num">Chapter {String(ch.num).padStart(2, "0")}</span>
        <span class="chapter-title">{ch[titleKey]}</span>
        <span class="chapter-desc">{ch[descKey]}</span>
      </div>
      <div class="chapter-meta">
        <span class="chapter-tag">{ch[tagKey]}</span>
        <span class="chapter-arrow" aria-hidden="true">&rarr;</span>
      </div>
    </a>
  ))}
</div>

<style>
  /* Asymmetric zig-zag grid: even cards slightly indented, odd flush left.
     Breaks the "3 equal columns" AI cliche and reads as editorial layout. */
  .chapters-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.9rem 1rem;
    margin: 1.75rem 0 2.5rem;
  }

  .chapter-card {
    grid-column: span 6;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.15rem 1.2rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--pify-r-lg);
    background: var(--sl-color-bg-nav);
    text-decoration: none;
    color: var(--sl-color-text);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.4s var(--pify-spring),
      border-color 0.25s var(--pify-ease),
      box-shadow 0.4s var(--pify-ease);
  }

  /* Subtle tinted gradient that respects accent */
  .chapter-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card-accent) 7%, transparent) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.35s var(--pify-ease);
  }

  /* Left accent bar */
  .chapter-card::after {
    content: "";
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 0;
    width: 2px;
    background: var(--card-accent);
    border-radius: 0 2px 2px 0;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.4s var(--pify-spring);
  }

  .chapter-card:hover {
    border-color: color-mix(in srgb, var(--card-accent) 40%, var(--sl-color-gray-5));
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--pify-ink) 4%, transparent),
      0 18px 36px -20px color-mix(in srgb, var(--card-accent) 50%, transparent);
  }

  .chapter-card:hover::before { opacity: 1; }
  .chapter-card:hover::after  { transform: scaleY(1); }

  /* Icon: top-right corner, restrained */
  .chapter-icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 1.6rem;
    height: 1.6rem;
    color: color-mix(in srgb, var(--card-accent) 70%, var(--sl-color-gray-3));
    transition: color 0.3s var(--pify-ease), transform 0.4s var(--pify-spring);
  }

  .chapter-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .chapter-card:hover .chapter-icon {
    color: var(--card-accent);
    transform: rotate(-3deg) scale(1.08);
  }

  .chapter-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
    padding-right: 2rem;
  }

  .chapter-num {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--card-accent) 65%, var(--sl-color-gray-3));
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .chapter-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
    color: var(--sl-color-text);
  }

  .chapter-desc {
    font-size: 0.86rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .chapter-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
  }

  .chapter-tag {
    display: inline-block;
    padding: 0.18rem 0.6rem;
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--card-accent) 70%, var(--sl-color-text));
    background: color-mix(in srgb, var(--card-accent) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-accent) 20%, transparent);
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .chapter-arrow {
    color: var(--sl-color-gray-3);
    font-size: 1rem;
    transition: color 0.3s var(--pify-ease), transform 0.4s var(--pify-spring);
  }

  .chapter-card:hover .chapter-arrow {
    color: var(--card-accent);
    transform: translateX(4px);
  }

  /* Asymmetric zig-zag: shift even rows to break monotony */
  .chapter-card:nth-child(odd)  { grid-column: 1 / span 6; }
  .chapter-card:nth-child(even) { grid-column: 2 / span 6; }

  /* Tablet: 2 columns, no offset */
  @media (max-width: 920px) {
    .chapter-card,
    .chapter-card:nth-child(odd),
    .chapter-card:nth-child(even) {
      grid-column: span 6;
    }
  }

  /* Mobile: single column */
  @media (max-width: 620px) {
    .chapters-grid {
      grid-template-columns: 1fr;
    }
    .chapter-card,
    .chapter-card:nth-child(odd),
    .chapter-card:nth-child(even) {
      grid-column: 1;
    }
  }

  /* Muted accent palette - all desaturated warm grays with one chapter slightly accented.
     Each card gets a "tint" that reads as a category, not a rainbow. */
  .accent-1  { --card-accent: #b45309; }   /* amber-700  - overview */
  .accent-2  { --card-accent: #57534e; }   /* stone-600  - architecture */
  .accent-3  { --card-accent: #0f766e; }   /* teal-700   - core */
  .accent-4  { --card-accent: #1d4ed8; }   /* blue-700   - integration */
  .accent-5  { --card-accent: #b91c1c; }   /* red-700    - runtime */
  .accent-6  { --card-accent: #6d28d9; }   /* violet-700 - data */
  .accent-7  { --card-accent: #047857; }   /* emerald-700- reactivity */
  .accent-8  { --card-accent: #a16207; }   /* yellow-700 - prompting */
  .accent-9  { --card-accent: #4338ca; }   /* indigo-700 - memory */
  .accent-10 { --card-accent: #44403c; }   /* stone-700  - persistence */
</style>
