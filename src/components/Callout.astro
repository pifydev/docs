---
interface Props {
  type?: "tip" | "note" | "caution" | "danger";
  title?: string;
}
const { type = "note", title } = Astro.props;
const icon =
  type === "tip" ? "💡" :
  type === "caution" ? "⚠️" :
  type === "danger" ? "🛑" : "ℹ️";
const defaultTitle =
  type === "tip" ? "Tip" :
  type === "caution" ? "Caution" :
  type === "danger" ? "Danger" : "Note";
---
<aside class={`callout callout--${type}`} role="note">
  <div class="callout-head">
    <span class="callout-icon" aria-hidden="true">{icon}</span>
    <span class="callout-title">{title ?? defaultTitle}</span>
  </div>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.25rem 0;
    padding: 0.85rem 1rem;
    border-inline-start: 3px solid var(--pify-accent);
    background: color-mix(in srgb, var(--pify-accent) 6%, transparent);
    border-radius: 0 var(--pify-r-sm) var(--pify-r-sm) 0;
  }
  .callout--tip     { border-color: #16a34a; background: color-mix(in srgb, #16a34a 6%, transparent); }
  .callout--note    { border-color: var(--pify-accent); }
  .callout--caution { border-color: #ca8a04; background: color-mix(in srgb, #ca8a04 8%, transparent); }
  .callout--danger  { border-color: #dc2626; background: color-mix(in srgb, #dc2626 8%, transparent); }

  .callout-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .callout-icon { font-size: 1rem; line-height: 1; }
  .callout-body :global(p) { margin: 0; }
  .callout-body :global(p + p) { margin-top: 0.5rem; }
</style>
