---
import Default from "@astrojs/starlight/components/Footer.astro";
const { entry } = Astro.locals.starlightRoute;
const filePath = entry?.filePath;
const ghBase = "https://github.com/pifydev/docs/blob/main";
const editBase = "https://github.com/pifydev/docs/edit/main";

const showViewSource = !!filePath;
const viewSourceUrl = filePath ? `${ghBase}/${filePath}` : null;
const editUrl = filePath ? `${editBase}/${filePath}` : null;
---

<Default><slot /></Default>

{showViewSource && (
  <div class="extra-meta sl-flex">
    <span class="extra-meta-label">Source:</span>
    <a href={viewSourceUrl} class="extra-meta-link" rel="noopener">
      View on GitHub
    </a>
    {editUrl && editUrl !== viewSourceUrl && (
      <>
        <span class="dot" aria-hidden="true">·</span>
        <a href={editUrl} class="extra-meta-link" rel="noopener">
          Edit page
        </a>
      </>
    )}
    <span class="dot" aria-hidden="true">·</span>
    <a href="https://github.com/pifydev/docs/issues/new" class="extra-meta-link" rel="noopener">
      Report an issue
    </a>
  </div>
)}

<style>
  .extra-meta {
    gap: 0.5rem;
    align-items: center;
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    flex-wrap: wrap;
  }
  .extra-meta-label {
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .extra-meta-link {
    color: var(--pify-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .extra-meta-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dot {
    color: var(--sl-color-gray-4);
  }
</style>
