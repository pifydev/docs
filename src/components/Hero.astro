---
import { Image } from "astro:assets";
import logoLight from "../assets/logo-on-light.svg";
import logoDark  from "../assets/logo-on-dark.svg";

const { lang } = Astro.props;

const titles = {
  zh: "Pify Agent Book",
  en: "Pify Agent Book",
  vi: "S\u00e1ch Pify Agent",
};

const tagline = {
  zh: "Pi Agent SDK \u6e90\u7801\u9605\u8bfb\u7b14\u8bb0",
  en: "Source-code reading notes for the Pi Agent SDK",
  vi: "Ghi ch\u00fa \u0111\u1ecdc m\u00e3 ngu\u1ed3n cho Pi Agent SDK",
};

const subtitle = {
  zh: "10 \u7ae0\u4ece\u5f15\u64ce\u67b6\u6784\u5230\u4f1a\u8bdd\u7ba1\u7406\u7684\u9010\u884c\u6e90\u7801\u89e3\u8bfb\u3002\u4e2d\u6587\u4e3a\u539f\u8457\uff0c\u82f1\u3001\u8d8a\u53cc\u8bed\u540c\u6b65\u7ffb\u8bd1\u3002",
  en: "10 chapters that walk through the Pi Agent SDK from architecture to session storage. Chinese is the canonical source; English and Vietnamese translations stay in lockstep.",
  vi: "10 ch\u01b0\u01a1ng duy\u1ec7t qua Pi Agent SDK t\u1eeb ki\u1ebfn tr\u00fac \u0111\u1ebfn qu\u1ea3n l\u00fd phi\u00ean. Ti\u1ebfng Trung l\u00e0 b\u1ea3n g\u1ed1c, ti\u1ebfng Anh v\u00e0 Vi\u1ec7t d\u1ecbch song song.",
};

const ctaStart = {
  zh: "\u5f00\u59cb\u9605\u8bfb",
  en: "Start reading",
  vi: "B\u1eaft \u0111\u1ea7u \u0111\u1ecdc",
};

const ctaGithub = {
  zh: "GitHub",
  en: "GitHub",
  vi: "GitHub",
};

const stats = {
  zh: [
    { value: "10", label: "\u7ae0" },
    { value: "30+", label: "\u4ee3\u7801\u793a\u4f8b" },
    { value: "7+", label: "\u67b6\u6784\u56fe" },
    { value: "3", label: "\u8bed\u8a00" },
  ],
  en: [
    { value: "10", label: "chapters" },
    { value: "30+", label: "code samples" },
    { value: "7+", label: "diagrams" },
    { value: "3", label: "languages" },
  ],
  vi: [
    { value: "10", label: "ch\u01b0\u01a1ng" },
    { value: "30+", label: "code m\u1eabu" },
    { value: "7+", label: "s\u01a1 \u0111\u1ed3" },
    { value: "3", label: "ng\u00f4n ng\u1eef" },
  ],
};

const features = {
  zh: [
    { icon: "book",  label: "10 \u7ae0\u7cfb\u7edf\u89e3\u8bfb" },
    { icon: "globe", label: "\u4e09\u8bed\u5bf9\u7167\u9605\u8bfb" },
    { icon: "graph", label: "Mermaid \u67b6\u6784\u56fe" },
    { icon: "code",  label: "\u53ef\u8fd0\u884c\u793a\u4f8b" },
  ],
  en: [
    { icon: "book",  label: "10 chapters, end-to-end" },
    { icon: "globe", label: "Three languages side-by-side" },
    { icon: "graph", label: "Mermaid architecture diagrams" },
    { icon: "code",  label: "Runnable code samples" },
  ],
  vi: [
    { icon: "book",  label: "10 ch\u01b0\u01a1ng, \u0111\u1ea7y \u0111\u1ee7" },
    { icon: "globe", label: "Ba ng\u00f4n ng\u1eef song song" },
    { icon: "graph", label: "S\u01a1 \u0111\u1ed3 Mermaid" },
    { icon: "code",  label: "Code m\u1eabu ch\u1ea1y \u0111\u01b0\u1ee3c" },
  ],
};

// Custom inline SVG icons (single stroke weight, no emoji)
const ICONS = {
  book:  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/></svg>',
  globe: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  graph: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="3" width="6" height="6" rx="1"/><rect x="9" y="15" width="6" height="6" rx="1"/><path d="M9 6h6M12 9v6M6 9v6"/></svg>',
  code:  '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 18-6-6 6-6M16 6l6 6-6 6M14 4l-4 16"/></svg>',
};
---
<section class="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orb" aria-hidden="true"></div>

  <a class="skip-link" href="#chapters">Skip to chapters</a>

  <div class="hero-inner">
    <div class="hero-mark">
      <Image src={logoLight} alt="Pify" class="hero-logo hero-logo-light" width="72" height="72" />
      <Image src={logoDark} alt="Pify" class="hero-logo hero-logo-dark" width="72" height="72" />
      <span class="hero-mark-tag">v1.0</span>
    </div>

    <span class="hero-eyebrow">
      <span class="hero-eyebrow-dot" aria-hidden="true"></span>
      Source-code reading notes
    </span>

    <h1 class="hero-title">{titles[lang]}</h1>

    <p class="hero-tagline">{tagline[lang]}</p>
    <p class="hero-subtitle">{subtitle[lang]}</p>

    <div class="hero-actions">
      <a class="hero-cta" href={`${import.meta.env.BASE_URL}/${lang}/ch01-overview`}>
        <span>{ctaStart[lang]}</span>
        <span class="hero-cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="hero-cta-secondary" href="https://github.com/pifydev/docs" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2c-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.24 3.34.95.1-.74.4-1.24.73-1.53-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.16 1.17a10.97 10.97 0 0 1 5.76 0c2.2-1.48 3.16-1.17 3.16-1.17.62 1.59.23 2.76.11 3.05.74.8 1.18 1.82 1.18 3.07 0 4.4-2.69 5.37-5.25 5.65.41.35.78 1.05.78 2.12v3.14c0 .31.21.68.8.56C20.21 21.39 23.5 17.07 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg>
        <span>{ctaGithub[lang]}</span>
      </a>
    </div>

    <ul class="hero-features">
      {features[lang].map((f) => (
        <li class="hero-feature">
          <span class="hero-feature-icon" set:html={ICONS[f.icon]} />
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <dl class="hero-stats" aria-label="Stats">
    {stats[lang].map((s) => (
      <div class="hero-stat">
        <dt class="hero-stat-value">{s.value}</dt>
        <dd class="hero-stat-label">{s.label}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 5.5rem 1.5rem 3.5rem;
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--sl-color-gray-4) 50%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--sl-color-gray-4) 50%, transparent) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 30%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, black 30%, transparent 100%);
  }

  .hero-orb {
    position: absolute;
    top: -25%;
    left: 50%;
    transform: translateX(-50%);
    width: min(85%, 640px);
    aspect-ratio: 1;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle, var(--pify-accent-glow) 0%, transparent 60%);
    filter: blur(40px);
    animation: hero-orb-drift 14s ease-in-out infinite alternate;
  }

  @keyframes hero-orb-drift {
    0%   { transform: translateX(-50%) translateY(0)     scale(1);    opacity: 0.85; }
    100% { transform: translateX(-46%) translateY(-20px) scale(1.08); opacity: 1;    }
  }

  .hero-inner {
    max-width: 880px;
    margin: 0 auto;
    text-align: left;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "mark eyebrow"
      "mark title"
      "mark tagline"
      "mark subtitle"
      "mark actions"
      "mark features";
    column-gap: 2rem;
    row-gap: 0.5rem;
    align-items: start;
  }

  .hero-mark {
    grid-area: mark;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.4rem;
  }

  .hero-logo {
    width: 72px;
    height: 72px;
    border-radius: 18px;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--pify-ink) 8%, transparent),
      0 18px 40px -16px color-mix(in srgb, var(--pify-accent) 30%, transparent);
    transition: transform 0.4s var(--pify-spring);
  }

  .hero-logo:hover {
    transform: rotate(-3deg) scale(1.04);
  }

  .hero-logo-dark { display: none; }
  :global([data-theme="dark"]) .hero-logo-light { display: none; }
  :global([data-theme="dark"]) .hero-logo-dark  { display: block; }

  .hero-mark-tag {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.05em;
  }

  .hero-eyebrow {
    grid-area: eyebrow;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.35rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pify-accent);
    background: color-mix(in srgb, var(--pify-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--pify-accent) 22%, transparent);
    border-radius: 999px;
    width: fit-content;
    margin-bottom: 0.6rem;
  }

  .hero-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pify-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--pify-accent) 25%, transparent);
    animation: hero-dot-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hero-dot-pulse {
    0%, 100% { opacity: 1;    transform: scale(1);    }
    50%      { opacity: 0.65; transform: scale(0.85); }
  }

  .hero-title {
    grid-area: title;
    margin: 0;
    font-size: clamp(2.5rem, 4.5vw + 1rem, 4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sl-color-text);
  }

  .hero-tagline {
    grid-area: tagline;
    margin: 0.5rem 0 0.3rem;
    color: var(--sl-color-text);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.4;
    text-wrap: balance;
  }

  .hero-subtitle {
    grid-area: subtitle;
    margin: 0;
    max-width: 44rem;
    color: var(--sl-color-gray-3);
    font-size: 0.98rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.45rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: white;
    background: var(--pify-ink);
    border: 1px solid var(--pify-ink);
    border-radius: 999px;
    text-decoration: none;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--pify-ink) 12%, transparent),
      0 12px 28px -10px color-mix(in srgb, var(--pify-ink) 35%, transparent);
    transition:
      transform 0.35s var(--pify-spring),
      box-shadow 0.35s var(--pify-ease),
      background 0.2s var(--pify-ease),
      border-color 0.2s var(--pify-ease);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    background: var(--pify-accent);
    border-color: var(--pify-accent);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--pify-ink) 12%, transparent),
      0 16px 36px -12px color-mix(in srgb, var(--pify-accent) 55%, transparent);
    text-decoration: none;
  }

  .hero-cta-arrow {
    transition: transform 0.35s var(--pify-spring);
    display: inline-block;
  }

  .hero-cta:hover .hero-cta-arrow {
    transform: translateX(4px);
  }

  .hero-cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.3rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sl-color-text);
    background: transparent;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 0.35s var(--pify-spring),
      border-color 0.2s var(--pify-ease),
      background 0.2s var(--pify-ease);
  }

  .hero-cta-secondary:hover {
    border-color: var(--pify-accent);
    background: color-mix(in srgb, var(--pify-accent) 6%, transparent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .hero-features {
    grid-area: features;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    max-width: 38rem;
  }

  .hero-feature {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    transition:
      border-color 0.2s var(--pify-ease),
      transform 0.3s var(--pify-spring),
      color 0.2s var(--pify-ease);
  }

  .hero-feature:hover {
    border-color: color-mix(in srgb, var(--pify-accent) 40%, var(--sl-color-gray-5));
    color: var(--sl-color-text);
    transform: translateY(-1px);
  }

  .hero-feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--pify-accent);
  }

  .hero-stats {
    margin: 3rem 0 0;
    padding: 1.4rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
  }

  .hero-stat-value {
    font-family: var(--sl-font);
    font-size: clamp(1.6rem, 1.2vw + 1rem, 2.2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-text);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1;
  }

  .hero-stat-label {
    margin: 0;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 3.5rem 1.25rem 2rem;
    }
    .hero-inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        "mark"
        "eyebrow"
        "title"
        "tagline"
        "subtitle"
        "actions"
        "features";
      text-align: center;
      justify-items: center;
    }
    .hero-mark {
      flex-direction: row;
      gap: 0.8rem;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-features {
      justify-content: center;
    }
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }
  }

  @media (max-width: 420px) {
    .hero-stat-value {
      font-size: 1.4rem;
    }
  }
</style>
